[Unit]
Description=Ansible Pull - Synchronize Server Base Configuration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# IMPORTANT: Replace the URL with your own repository
# NOTE: ansible-pull has no "-r/--requirements" option (that flag only exists
# for ansible-playbook). Role/collection dependencies from requirements.yml
# must be installed separately via "ansible-galaxy install -r requirements.yml".
# ExecStartPre re-installs them from the previous checkout on every run, so
# they stay up to date automatically once the very first checkout exists
# (see README step 2b for the required manual bootstrap on a brand-new VM).
ExecStartPre=/bin/sh -c 'f="/root/.ansible/pull/$(hostname)/requirements.yml"; [ -f "$f" ] && ansible-galaxy install -r "$f" -f || true'
ExecStart=/usr/bin/ansible-pull \
    -U https://github.com/ToXiCCuss/gitops-ansible.git \
    -C master \
    -i inventory.ini \
    --only-if-changed \
    site.yml
