[Unit]
Description=Ansible Pull - Server-Basis-Konfiguration synchronisieren
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# WICHTIG: Ersetze die URL durch dein eigenes Repository
ExecStart=/usr/bin/ansible-pull \
    -U https://github.com/DEIN_ORG/server-config.git \
    -C main \
    -r requirements.yml \
    -i inventory.ini \
    --only-if-changed \
    site.yml
